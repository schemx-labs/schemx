{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemx.dev/schemas/release-data.schema.json",
  "title": "SchemaForm Release Data",
  "type": "object",
  "required": [
    "version",
    "date",
    "from",
    "to",
    "range",
    "scope",
    "packages",
    "summary",
    "changes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "from": {
      "$ref": "#/$defs/releasePoint"
    },
    "to": {
      "$ref": "#/$defs/releasePoint"
    },
    "range": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "repository",
        "package"
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "knownIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownIssue"
      }
    },
    "fullChangelog": {
      "type": "string"
    }
  },
  "$defs": {
    "releasePoint": {
      "type": "object",
      "required": [
        "commit"
      ],
      "properties": {
        "tag": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "primaryCategory",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "primaryCategory": {
          "enum": [
            "breaking",
            "security",
            "feature",
            "improvement",
            "fix",
            "deprecation",
            "dependency",
            "documentation"
          ]
        },
        "facets": {
          "type": "array",
          "items": {
            "enum": [
              "api",
              "typescript",
              "runtime",
              "ui",
              "compatibility"
            ]
          }
        },
        "userImpact": {
          "type": "string"
        },
        "migration": {
          "$ref": "#/$defs/migration"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "affected": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replacement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "needs-maintainer-input"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "commits"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "environment": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "knownIssue": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "affected": {
          "type": "string"
        },
        "workaround": {
          "type": "string"
        }
      }
    }
  }
}
