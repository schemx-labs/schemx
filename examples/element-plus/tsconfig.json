{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@schemx/core": ["../../packages/core/src/index.ts"],
      "@schemx/core/*": ["../../packages/core/src/*"],
      "@schemx/vue": ["../../packages/vue/src/index.ts"],
      "@schemx/vue/*": ["../../packages/vue/src/*"],
      "@schemx/element-plus": ["../../packages/element-plus/src/index.ts"],
      "@schemx/element-plus/*": ["../../packages/element-plus/src/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "build"]
}
