{
  "name": "vite-plugin-workspace-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Vite and TypeScript workspace source resolution",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "workspace-source": "./bin/workspace-source.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run build && vp test run",
    "lint": "vp lint src test bin",
    "format:check": "vp fmt --check src test bin",
    "check": "pnpm run lint && pnpm run format:check && pnpm run type-check"
  }
}
