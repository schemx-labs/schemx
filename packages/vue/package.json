{
  "type": "module",
  "name": "@schemx/vue",
  "version": "1.2.0",
  "description": "基于 JSON Schema 配置的 Vue 3 动态表单引擎（UI 无关核心）",
  "keywords": [
    "schemx",
    "vue",
    "vue3",
    "form",
    "dynamic-form",
    "json-schema",
    "form-renderer"
  ],
  "homepage": "https://github.com/Jiohon/schemx/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/Jiohon/schemx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jiohon/schemx.git",
    "directory": "packages/vue"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/index.ts"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@schemx/core": "workspace:*",
    "classnames": "^2.5.1",
    "csstype": "^3.2.3",
    "es-toolkit": "catalog:",
    "scroll-into-view-if-needed": "^3.1.0"
  },
  "scripts": {
    "build": "pnpm run type-check && vp build",
    "build:analyze": "vp build",
    "test": "vp test run",
    "lint": "eslint \"src/**/*.{ts,tsx,vue,js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,vue,js,jsx}\" --fix",
    "format": "vp fmt \"src/**/*.{ts,tsx,vue,js,jsx,json,css,scss}\"",
    "format:check": "vp fmt --check \"src/**/*.{ts,tsx,vue,js,jsx,json,css,scss}\"",
    "type-test": "vue-tsc -p tsconfig.type-tests.json --noEmit",
    "type-check": "vue-tsc -p tsconfig.json --noEmit && pnpm run type-test",
    "check": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "prepublishOnly": "pnpm run build",
    "pack-local": "node ../../scripts/workflow.ts pack-local --target packages/vue"
  },
  "license": "MIT",
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "vue": "catalog:",
    "vue-tsc": "^3.3.9",
    "zod": "^4.3.6"
  }
}
