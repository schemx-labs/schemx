{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@schemx/core": ["../core/src/index.ts"],
      "@schemx/core/adapter": ["../core/src/adapter/index.ts"],
      "@schemx/core/*": ["../core/src/*"]
