{
  "type": "module",
  "name": "@schemx/core",
  "version": "1.1.1",
  "description": "框架无关的表单引擎核心（Framework-agnostic form engine core）",
  "keywords": [
    "schemx",
    "form",
    "form-engine",
    "dynamic-form",
    "json-schema",
    "validation",
    "framework-agnostic"
  ],
  "homepage": "https://github.com/Jiohon/schemx/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Jiohon/schemx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jiohon/schemx.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter/index.d.ts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter/index.d.ts",
        "default": "./dist/adapter.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@preact/signals-core": "^1.14.0",
    "csstype": "^3.2.3",
    "es-toolkit": "catalog:",
    "async-validator": "^4.2.5"
  },
  "scripts": {
    "build": "vp build",
    "build:analyze": "vp build --mode analyze",
    "test": "vp test run",
    "lint": "eslint \"src/**/*.{ts,tsx,vue,js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,vue,js,jsx}\" --fix",
    "format": "vp fmt \"src/**/*.{ts,tsx,vue,js,jsx,json,css,scss}\"",
    "format:check": "vp fmt --check \"src/**/*.{ts,tsx,vue,js,jsx,json,css,scss}\"",
    "type-test": "pnpm run test:type-check",
    "test:type-check": "tsc -p tsconfig.test.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit && pnpm run test:type-check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "prepublishOnly": "pnpm run build",
    "pack-local": "node ../../scripts/workflow.ts pack-local --target packages/core"
  },
  "license": "MIT",
  "devDependencies": {
    "fast-check": "^4.6.0"
  }
}
